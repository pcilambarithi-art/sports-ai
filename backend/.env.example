# Application
APP_NAME=ApexPulse AI Sports Coaching System
APP_ENV=development
DEBUG=false

# Security (override in production!)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=720
SENSOR_API_KEY=sensor-ingest-key-change-in-production

# Database
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sports_coaching
# Default local SQLite fallback (works out of the box without PostgreSQL installed):
DATABASE_URL=sqlite:///./sports_coaching.db

# Existing Trained ML Model & Dataset Paths (READ-ONLY - never overwritten)
MODEL_DIR=D:\V3\trained_models
MODEL_FILE=calorie_prediction_model.pkl
PREPROCESSOR_FILE=preprocessor.pkl
MODEL_FEATURES_FILE=model_features.pkl
FEATURE_INFO_FILE=feature_info.pkl
DATASET_PATH=D:\V3\preprocessed_workout_dataset.csv
AUTO_LOAD_MODEL=true

# File Storage
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=150

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://pcilambarithi-art.github.io
