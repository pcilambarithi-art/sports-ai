project_name      = "apexpulse-sports"
environment       = "staging"
aws_region        = "us-east-1"
ec2_instance_type = "m6i.xlarge"
ec2_key_name      = ""
admin_cidr        = "0.0.0.0/0"
db_instance_class = "db.t4g.micro"
db_name           = "sports_coaching"
db_username       = "apexpulse_admin"
# Replace with strong secrets before running terraform apply:
db_password       = "REPLACE_WITH_STRONG_DB_PASSWORD_16CHARS"
app_secret_key    = "REPLACE_WITH_RANDOM_32_BYTE_JWT_SECRET_KEY"
sensor_api_key    = "REPLACE_WITH_RANDOM_SENSOR_INGEST_API_KEY"
